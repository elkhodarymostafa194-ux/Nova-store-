<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head link rel="manifest" href="./manifest.json">
<meta name="theme-color" content="#5145a8">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="NOVA Store - اكتشف منتجاتك المفضلة بتجربة تسوق سهلة وأنيقة.">
<meta name="theme-color" content="#10131d">
<title>NOVA Store | تسوّق بذكاء</title>
<style>
:root{--bg:#0d1018;--panel:#151a27;--panel2:#1b2232;--text:#f5f7fb;--muted:#a9b2c4;--accent:#9b8cff;--accent2:#5eead4;--line:#293247}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--text);font-family:system-ui,-apple-system,"Segoe UI",Tahoma,Arial,sans-serif;line-height:1.7}a{color:inherit;text-decoration:none}button,input{font:inherit}.wrap{width:min(1120px,92%);margin:auto}
header{position:sticky;top:0;z-index:10;background:#0d1018eF;backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}
.nav{height:76px;display:flex;align-items:center;justify-content:space-between;gap:18px}.brand{font-size:1.45rem;font-weight:900;letter-spacing:1px}.brand span{color:var(--accent)}.links{display:flex;gap:24px;color:var(--muted);font-size:.95rem}.links a:hover{color:var(--text)}.nav-actions{display:flex;gap:10px;align-items:center}.lang,.cart{border:1px solid var(--line);background:var(--panel);color:var(--text);padding:9px 13px;border-radius:12px;cursor:pointer}.cart b{background:var(--accent);color:#111;padding:1px 7px;border-radius:20px;margin-inline-start:5px}
.hero{padding:72px 0 55px;background:radial-gradient(ellipse at 80% 10%,#5b4bb533,transparent 45%),radial-gradient(ellipse at 10% 80%,#2dd4bf18,transparent 40%)}
.hero-grid{display:grid;grid-template-columns:1.1fr .9fr;align-items:center;gap:35px}.eyebrow{color:var(--accent2);font-weight:700}.hero h1{font-size:clamp(2.4rem,6vw,4.5rem);line-height:1.15;margin:12px 0 18px}.hero h1 span{color:var(--accent)}.hero p{color:var(--muted);max-width:560px;font-size:1.08rem}.primary{display:inline-block;background:linear-gradient(110deg,var(--accent),#6e9cff);color:#10131d;padding:13px 22px;border-radius:13px;font-weight:850;margin-top:16px;border:0;cursor:pointer}.hero-art{min-height:310px;border:1px solid #ffffff18;border-radius:30px;background:linear-gradient(145deg,#252b43,#121725);display:grid;place-items:center;position:relative;overflow:hidden}.orb{width:210px;height:210px;border-radius:50%;background:linear-gradient(135deg,#a99cff,#5eead4);filter:drop-shadow(0 25px 45px #8b7cff55);display:grid;place-items:center;color:#171526;font-size:3rem;font-weight:1000;transform:rotate(-12deg)}.hero-art:before,.hero-art:after{content:"";position:absolute;border:1px solid #ffffff20;border-radius:50%;width:290px;height:290px}.hero-art:after{width:370px;height:370px}
section{padding:55px 0}.section-head{display:flex;justify-content:space-between;align-items:end;gap:15px;margin-bottom:22px}.section-head h2{font-size:2rem;margin:0}.section-head p{color:var(--muted);margin:4px 0 0}.search{width:min(300px,100%);background:var(--panel);border:1px solid var(--line);border-radius:12px;color:var(--text);padding:12px 14px;outline:none}.categories{display:flex;gap:10px;flex-wrap:wrap;margin:18px 0 24px}.chip{background:var(--panel);border:1px solid var(--line);color:var(--muted);padding:8px 15px;border-radius:30px;cursor:pointer}.chip.active,.chip:hover{background:var(--accent);color:#10131d;border-color:var(--accent)}
.products{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.product{background:var(--panel);border:1px solid var(--line);border-radius:20px;overflow:hidden;transition:.2s}.product:hover{transform:translateY(-5px);border-color:#8274e8}.product-art{height:190px;display:grid;place-items:center;font-size:4.5rem;background:linear-gradient(135deg,#222b43,#171b2a)}.product-body{padding:17px}.tag{color:var(--accent2);font-size:.8rem}.product h3{margin:4px 0;font-size:1.1rem}.product p{color:var(--muted);font-size:.9rem;margin:5px 0 13px}.price-row{display:flex;align-items:center;justify-content:space-between;gap:8px}.price{font-weight:900;font-size:1.15rem}.add{border:0;background:var(--accent);color:#111;padding:9px 13px;border-radius:10px;font-weight:800;cursor:pointer}
.benefits{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.benefit{padding:20px;border:1px solid var(--line);border-radius:18px;background:var(--panel)}.benefit strong{display:block;margin:8px 0}.benefit p{color:var(--muted);margin:0;font-size:.92rem}.icon{font-size:1.7rem}
.about{background:linear-gradient(120deg,#171b2b,#111622);border:1px solid var(--line);border-radius:24px;padding:30px}.about p{color:var(--muted);max-width:760px}
footer{border-top:1px solid var(--line);padding:28px 0;color:var(--muted)}.footer-row{display:flex;justify-content:space-between;gap:15px;flex-wrap:wrap}
.cart-panel{position:fixed;inset:0;background:#0009;z-index:30;display:none;justify-content:flex-end}.cart-panel.open{display:flex}.cart-box{width:min(420px,92%);height:100%;background:var(--panel);padding:22px;overflow:auto}.cart-top{display:flex;justify-content:space-between;align-items:center}.close{background:transparent;border:0;color:var(--text);font-size:1.5rem;cursor:pointer}.cart-item{display:flex;justify-content:space-between;border-bottom:1px solid var(--line);padding:13px 0;gap:12px}.checkout{display:block;text-align:center;background:var(--accent2);color:#10131d;padding:13px;border-radius:12px;font-weight:900;margin-top:18px}.empty{color:var(--muted);padding:30px 0;text-align:center}
.notice{font-size:.82rem;color:var(--muted);margin-top:12px}
@media(max-width:760px){.links{display:none}.hero{padding:48px 0 30px}.hero-grid{grid-template-columns:1fr}.hero-art{min-height:220px}.orb{width:150px;height:150px;font-size:2.2rem}.products{grid-template-columns:repeat(2,1fr)}.product-art{height:145px;font-size:3.5rem}.section-head{align-items:stretch;flex-direction:column}.benefits{grid-template-columns:1fr}.nav{height:66px}}
@media(max-width:430px){.products{grid-template-columns:1fr}.product-art{height:180px}}
</style>
</head>

<script>
if ("serviceWorker" in navigator) {
  window.addEventListener("load", () => {
    navigator.serviceWorker.register("./sw.js")
      .then(() => console.log("PWA Ready"))
      .catch(error => console.error("PWA Error:", error));
  });
}
</script>

<body>
<header><div class="wrap nav">
<a class="brand" href="#">NOVA<span>.</span>STORE</a>
<nav class="links"><a href="#home" data-ar="الرئيسية" data-en="Home">الرئيسية</a><a href="#products" data-ar="المنتجات" data-en="Products">المنتجات</a><a href="#about" data-ar="من نحن" data-en="About">من نحن</a><a href="#contact" data-ar="تواصل معنا" data-en="Contact">تواصل معنا</a></nav>
<div class="nav-actions"><button class="lang" id="langBtn">EN</button><button class="cart" id="openCart">السلة <b id="cartCount">0</b></button></div>
</div></header>
<main>
<div class="hero" id="home"><div class="wrap hero-grid">
<div><div class="eyebrow" data-ar="اكتشف أسلوبك • تسوّق بذكاء" data-en="DISCOVER YOUR STYLE • SHOP SMART">اكتشف أسلوبك • تسوّق بذكاء</div>
<h1 data-ar="كل ما تحبه،<br><span>في مكان واحد.</span>" data-en="Everything you love,<br><span>in one place.</span>">كل ما تحبه،<br><span>في مكان واحد.</span></h1>
<p data-ar="مرحبًا بك في NOVA Store. اكتشف مجموعة مختارة من المنتجات العصرية، واستمتع بتجربة تسوق بسيطة وسريعة من هاتفك." data-en="Welcome to NOVA Store. Explore a curated collection of modern essentials and enjoy a simple shopping experience from your phone.">مرحبًا بك في NOVA Store. اكتشف مجموعة مختارة من المنتجات العصرية، واستمتع بتجربة تسوق بسيطة وسريعة من هاتفك.</p>
<a class="primary" href="#products" data-ar="تسوق الآن ←" data-en="Shop now →">تسوق الآن ←</a></div>
<div class="hero-art"><div class="orb">NOVA</div></div>
</div></div>
<section id="products"><div class="wrap">
<div class="section-head"><div><h2 data-ar="اختياراتنا لك" data-en="Picked for you">اختياراتنا لك</h2><p data-ar="منتجات مميزة — أضف منتجاتك وأسعارك قبل استقبال الطلبات." data-en="Featured products — customize products and prices before accepting orders.">منتجات مميزة — أضف منتجاتك وأسعارك قبل استقبال الطلبات.</p></div><input class="search" id="search" placeholder="ابحث عن منتج..." aria-label="Search products"></div>
<div class="categories" id="categories"><button class="chip active" data-category="all">الكل</button><button class="chip" data-category="tech">إلكترونيات</button><button class="chip" data-category="style">أناقة</button><button class="chip" data-category="home">المنزل</button></div>
<div class="products" id="productsGrid"></div>
<p class="notice">* المنتجات والأسعار المعروضة أمثلة تجريبية. عدّلها قبل نشر المتجر واستقبال طلبات حقيقية.</p>
</div></section>
<section><div class="wrap benefits">
<div class="benefit"><div class="icon">🚚</div><strong data-ar="توصيل محلي" data-en="Local delivery">توصيل محلي</strong><p data-ar="نسّق التوصيل مع العميل قبل تأكيد الطلب." data-en="Arrange delivery with the customer before confirming an order.">نسّق التوصيل مع العميل قبل تأكيد الطلب.</p></div>
<div class="benefit"><div class="icon">💬</div><strong data-ar="تواصل مباشر" data-en="Direct support">تواصل مباشر</strong><p data-ar="استفسارات وطلبات عبر واتساب." data-en="Questions and orders through WhatsApp.">استفسارات وطلبات عبر واتساب.</p></div>
<div class="benefit"><div class="icon">✨</div><strong data-ar="تجربة سهلة" data-en="Easy experience">تجربة سهلة</strong><p data-ar="تصفح واضح يناسب الموبايل والكمبيوتر." data-en="A clean experience for mobile and desktop.">تصفح واضح يناسب الموبايل والكمبيوتر.</p></div>
</div></section>
<section id="about"><div class="wrap about"><h2 data-ar="عن NOVA Store" data-en="About NOVA Store">عن NOVA Store</h2><p data-ar="NOVA Store وجهتك لاكتشاف منتجات متنوعة بتجربة رقمية عصرية. نعمل على تقديم تجربة تسوق واضحة وسهلة، مع دعم مباشر لمساعدتك قبل إتمام طلبك." data-en="NOVA Store is your destination for discovering a variety of products through a modern digital experience. We aim to make shopping clear and simple, with direct support before you place an order.">NOVA Store وجهتك لاكتشاف منتجات متنوعة بتجربة رقمية عصرية. نعمل على تقديم تجربة تسوق واضحة وسهلة، مع دعم مباشر لمساعدتك قبل إتمام طلبك.</p></div></section>
</main>
<footer id="contact"><div class="wrap footer-row"><div><a class="brand" href="#">NOVA<span>.</span>STORE</a><div data-ar="تسوّق بذكاء. عش أفضل." data-en="Shop smart. Live better.">تسوّق بذكاء. عش أفضل.</div></div><div><strong data-ar="تواصل معنا" data-en="Contact us">تواصل معنا</strong><div>WhatsApp: أضف رقم متجرك هنا</div><small>© <span id="year"></span> NOVA Store</small></div></div></footer>
<div class="cart-panel" id="cartPanel"><div class="cart-box"><div class="cart-top"><h2 data-ar="سلة التسوق" data-en="Your cart">سلة التسوق</h2><button class="close" id="closeCart">×</button></div><div id="cartItems" class="empty">السلة فارغة حاليًا</div><div class="price-row"><strong data-ar="الإجمالي" data-en="Total">الإجمالي</strong><strong id="total">0 ج.م</strong></div><a class="checkout" id="checkout" href="#" target="_blank" rel="noopener">إتمام الطلب عبر واتساب</a><p class="notice">أضف رقم واتساب الحقيقي في الكود قبل استقبال الطلبات.</p></div></div>
<script>
const products=[
{id:1,name:"سماعة لاسلكية",en:"Wireless headphones",desc:"صوت واضح وتصميم مريح للاستخدام اليومي.",price:650,icon:"🎧",cat:"tech",tag:"الأكثر طلبًا"},
{id:2,name:"ساعة ذكية",en:"Smart watch",desc:"تابع يومك بإطلالة عصرية.",price:900,icon:"⌚",cat:"tech",tag:"تقنية"},
{id:3,name:"حقيبة يومية",en:"Everyday bag",desc:"تصميم عملي يناسب الخروجات اليومية.",price:480,icon:"👜",cat:"style",tag:"أناقة"},
{id:4,name:"نظارة عصرية",en:"Modern sunglasses",desc:"لمسة بسيطة تكمل إطلالتك.",price:350,icon:"🕶️",cat:"style",tag:"اختيار مميز"},
{id:5,name:"مصباح ديكوري",en:"Decorative lamp",desc:"إضاءة هادئة تضيف لمسة جميلة للمكان.",price:420,icon:"💡",cat:"home",tag:"للمنزل"},
{id:6,name:"زجاجة حرارية",en:"Thermal bottle",desc:"احتفظ بمشروبك بدرجة الحرارة المناسبة.",price:290,icon:"🥤",cat:"home",tag:"عملي"}
];
let cart=[],category="all",lang="ar";
const $=s=>document.querySelector(s);
function render(){
 const q=$("#search").value.trim().toLowerCase();
 const list=products.filter(p=>(category==="all"||p.cat===category)&&(p.name.toLowerCase().includes(q)||p.en.toLowerCase().includes(q)));
 $("#productsGrid").innerHTML=list.map(p=>`<article class="product"><div class="product-art">${p.icon}</div><div class="product-body"><span class="tag">${p.tag}</span><h3>${lang==="ar"?p.name:p.en}</h3><p>${p.desc}</p><div class="price-row"><span class="price">${p.price.toLocaleString("en-US")} ${lang==="ar"?"ج.م":"EGP"}</span><button class="add" onclick="addToCart(${p.id})">${lang==="ar"?"أضف للسلة":"Add to cart"}</button></div></div></article>`).join("")||'<p class="empty">لا توجد منتجات مطابقة.</p>';
}
function addToCart(id){const item=cart.find(x=>x.id===id);item?item.qty++:cart.push({id,qty:1});renderCart()}
function renderCart(){
 $("#cartCount").textContent=cart.reduce((s,x)=>s+x.qty,0);
 const items=cart.map(x=>{const p=products.find(y=>y.id===x.id);return `<div class="cart-item"><span>${p.icon} ${lang==="ar"?p.name:p.en} × ${x.qty}</span><strong>${(p.price*x.qty).toLocaleString("en-US")} ج.م</strong></div>`}).join("");
 $("#cartItems").innerHTML=items||'<div class="empty">السلة فارغة حاليًا</div>';
 const total=cart.reduce((s,x)=>s+products.find(p=>p.id===x.id).price*x.qty,0);
 $("#total").textContent=total.toLocaleString("en-US")+" ج.م";
 // ضع رقم واتساب متجرك بصيغة دولية بدون + أو مسافات بدل الرقم التجريبي أدناه.
 const whatsappNumber="201000000000";
 const message="مرحبًا، أريد طلب:\n"+cart.map(x=>{const p=products.find(y=>y.id===x.id);return `${p.name} × ${x.qty}`}).join("\n")+"\nالإجمالي: "+total+" جنيه";
 $("#checkout").href="https://wa.me/"+whatsappNumber+"?text="+encodeURIComponent(message);
}
$("#openCart").onclick=()=>$("#cartPanel").classList.add("open");
$("#closeCart").onclick=()=>$("#cartPanel").classList.remove("open");
$("#cartPanel").onclick=e=>{if(e.target.id==="cartPanel")e.currentTarget.classList.remove("open")};
$("#search").addEventListener("input",render);
$("#categories").addEventListener("click",e=>{if(e.target.matches("button")){category=e.target.dataset.category;document.querySelectorAll(".chip").forEach(b=>b.classList.toggle("active",b===e.target));render()}});
$("#langBtn").onclick=()=>{lang=lang==="ar"?"en":"ar";document.documentElement.lang=lang;document.documentElement.dir=lang==="ar"?"rtl":"ltr";$("#langBtn").textContent=lang==="ar"?"EN":"AR";document.querySelectorAll("[data-ar]").forEach(el=>el.innerHTML=el.dataset[lang]);$("#search").placeholder=lang==="ar"?"ابحث عن منتج...":"Search products...";render();renderCart()};
$("#year").textContent=new Date().getFullYear();render();renderCart();
</script>
</body></html>
